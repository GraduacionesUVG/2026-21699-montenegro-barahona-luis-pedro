
# -----------------------------------------------------------------------------
# Shared Ollama service and default local models
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CHAT_MODEL_DIGEST=...

OLLAMA_EMBEDDING_MODEL=nomic-embed-text:137m-v1.5-fp16
OLLAMA_EMBEDDING_MODEL_DIGEST=
OLLAMA_EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# Public responder
# -----------------------------------------------------------------------------
# Leave RESPONDER_MODEL empty to inherit OLLAMA_CHAT_MODEL.
RESPONDER_PROVIDER=ollama
RESPONDER_MODEL=...
RESPONDER_MODEL_DIGEST=...
RESPONDER_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESPONDER_TEMPERATURE=0
RESPONDER_SEED=42
RESPONDER_MAX_OUTPUT_TOKENS=512
RESPONDER_TIMEOUT_SECONDS=180

# The tokenizer ID and revision are frozen in each condition profile. These
# values only control local caching and whether Hugging Face downloads are
# permitted. Set LOCAL_FILES_ONLY=true after the required tokenizer is cached.
RESPONDER_TOKENIZER_CACHE_DIR=artifacts/models/tokenizers
RESPONDER_TOKENIZER_LOCAL_FILES_ONLY=false

# -----------------------------------------------------------------------------
# Agent action decider
# -----------------------------------------------------------------------------
# Leave the model empty to inherit the Ollama responder/chat model. GPT-OSS
# conditions generally require AGENT_DECIDER_THINK=false so the canonical
# decision is returned in message.content rather than only message.thinking.
AGENT_DECIDER_MODEL=...
AGENT_DECIDER_MODEL_DIGEST=...
AGENT_DECIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_DECIDER_TEMPERATURE=0
AGENT_DECIDER_SEED=42
AGENT_DECIDER_MAX_OUTPUT_TOKENS=512
AGENT_DECIDER_TIMEOUT_SECONDS=180
AGENT_DECIDER_THINK=false

# Enable only while diagnosing model/parser behavior. Raw responses are sealed
# as evaluator-only evidence and may substantially increase artifact size.
AGENT_DECIDER_CAPTURE_RAW_RESPONSE=false

# -----------------------------------------------------------------------------
# TeleMem runtime
# -----------------------------------------------------------------------------
TELEMEM_PROVIDER=ollama
TELEMEM_STORAGE_ROOT=artifacts/memory/telemem
TELEMEM_BUFFER_SIZE=64
TELEMEM_SIMILARITY_THRESHOLD=0.95

# Empty means that no additional retrieval threshold is applied.
TELEMEM_RETRIEVAL_THRESHOLD=...
TELEMEM_RERANK=false

TELEMEM_VISIBILITY_TIMEOUT_SECONDS=30
TELEMEM_POLL_INTERVAL_SECONDS=0.25

# Used only when TELEMEM_PROVIDER=openai.
TELEMEM_OPENAI_BASE_URL=https://api.openai.com/v1
TELEMEM_OPENAI_CHAT_MODEL=gpt-5-mini
TELEMEM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TELEMEM_OPENAI_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# LangMem runtime
# -----------------------------------------------------------------------------
LANGMEM_PROVIDER=ollama
LANGMEM_WRITER_MODEL=qwen2.5:7b
LANGMEM_WRITER_MODEL_DIGEST=...
LANGMEM_EMBEDDING_PROVIDER=ollama

LANGMEM_MEMORY_TYPES=semantic
LANGMEM_ENABLE_DELETES=false
LANGMEM_QUERY_LIMIT=5
LANGMEM_MAX_STEPS=10
LANGMEM_TEMPERATURE=0
LANGMEM_SEED=42
LANGMEM_TIMEOUT_SECONDS=300

# Supported values: memory, sqlite, postgres.
LANGMEM_STORAGE_BACKEND=sqlite
LANGMEM_SQLITE_ROOT=artifacts/memory/langmem

# Used only by OpenAI-backed LangMem profiles.
LANGMEM_OPENAI_BASE_URL=https://api.openai.com/v1
LANGMEM_OPENAI_WRITER_MODEL=gpt-4o-mini-2024-07-18
LANGMEM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LANGMEM_OPENAI_EMBEDDING_DIMENSIONS=1536

# Used only when LANGMEM_STORAGE_BACKEND=postgres.
LANGGRAPH_POSTGRES_IMAGE=pgvector/pgvector@sha256:eac621400b7b7ff52493883e41e930e3d104695fea5b68cc0c42370cf7880067
LANGGRAPH_POSTGRES_CONTAINER=membench-langgraph-postgres
LANGGRAPH_POSTGRES_DSN=postgresql://membench:change-me@127.0.0.1:5432/membench

# -----------------------------------------------------------------------------
# Dakera runtime (optional)
# -----------------------------------------------------------------------------
# Dakera requires a credential when selected. Leave DAKERA_API_KEY empty when
# Dakera is not part of the scenario matrix.
DAKERA_URL=http://127.0.0.1:3300
DAKERA_API_KEY=
DAKERA_MEMORY_TYPE=semantic
DAKERA_IMPORTANCE=0.5
DAKERA_TOP_K=5
DAKERA_ROUTING=vector
DAKERA_RERANK=false
DAKERA_NEIGHBORHOOD=false
DAKERA_INCLUDE_ASSOCIATED=false
DAKERA_TIMEOUT_SECONDS=30
DAKERA_VISIBILITY_TIMEOUT_SECONDS=30
DAKERA_POLL_INTERVAL_SECONDS=0.25
DAKERA_MAX_RETRIES=3
DAKERA_AGENT_PREFIX=membench
DAKERA_TTL_SECONDS=
DAKERA_SERVER_VERSION=
DAKERA_SERVER_IMAGE=

# -----------------------------------------------------------------------------
# Optional OpenAI-compatible provider
# -----------------------------------------------------------------------------
# These are ignored by the default Ollama profiles.
# Not fully developed, use Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RESPONDER_OPENAI_BASE_URL=https://api.openai.com/v1
RESPONDER_OPENAI_MODEL=gpt-5-mini
